{
  "name": "cn-physics-lab",
  "version": "0.2.0-dev.1",
  "private": true,
  "license": "Apache-2.0",
  "author": "jerryshi1968",
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test \"tests/physics/*.test.mjs\" \"tests/core/*.test.mjs\"",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && npm run licenses && vite build",
    "licenses": "node scripts/dependency-inventory.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "sample": "node scripts/physics-samples.mjs"
  },
  "dependencies": {
    "matter-js": "0.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/matter-js": "0.20.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
